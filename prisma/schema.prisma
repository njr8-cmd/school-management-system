generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id              String           @id @default(cuid())
  name            String
  shortName       String?
  address         String?
  phone           String?
  email           String?
  website         String?
  establishedYear Int?
  description     String?
  logo            String?
  coverImage      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  academicYears   AcademicYear[]
  classes         Class[]
  infrastructure  Infrastructure[]
  sections        Section[]
  students        Student[]
  teachers        Teacher[]
}

model User {
  id                     String                  @id @default(cuid())
  name                   String
  email                  String                  @unique
  password               String
  role                   UserRole                @default(ACCOUNTANT)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  issuedStudentCredits   StudentCredit[]         @relation("StudentCreditIssuer")
  appliedBillCredits     BillCreditApplication[] @relation("BillCreditApplicationActor")
  reversedBillCredits    BillCreditApplication[] @relation("BillCreditApplicationReverser")
  recordedSalaryPayments TeacherSalaryPayment[]  @relation("SalaryPaymentRecorder")
  voidedExpenses         Expense[]               @relation("ExpenseVoider")
}

model Infrastructure {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model AcademicYear {
  id                 String              @id @default(cuid())
  schoolId           String
  name               String
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  terms              AcademicTerm[]
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bills              Bill[]
  classSubjects      ClassSubject[]
  enrollments        Enrollment[]
  expenses           Expense[]
  feeStructures      FeeStructure[]
  studentCharges     StudentCharge[]
  studentCredits     StudentCredit[]
  studentDiscounts   StudentDiscount[]
  teacherAssignments TeacherAssignment[]
  teacherSalaries    TeacherSalary[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Class {
  id                 String              @id @default(cuid())
  schoolId           String
  name               String
  order              Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects           ClassSubject[]
  enrollments        Enrollment[]
  exams              Exam[]
  feeStructures      FeeStructure[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id          String       @id @default(cuid())
  schoolId    String
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Student {
  id              String            @id @default(cuid())
  schoolId        String
  admissionNumber String
  firstName       String
  middleName      String?
  lastName        String?
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  phone           String?
  email           String?
  fatherName      String?
  motherName      String?
  guardianName    String?
  guardianPhone   String?
  photo           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bills           Bill[]
  enrollments     Enrollment[]
  marks           Mark[]
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  charges         StudentCharge[]
  credits         StudentCredit[]
  discounts       StudentDiscount[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
}

model Teacher {
  id            String              @id @default(cuid())
  schoolId      String
  firstName     String
  middleName    String?
  lastName      String?
  dateOfBirth   DateTime?
  gender        String?
  address       String?
  phone         String?
  email         String?
  position      String?
  joiningDate   DateTime?
  basicSalary   Decimal?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments   TeacherAssignment[]
  salaryRecords TeacherSalary[]

  @@index([schoolId])
}

model Enrollment {
  id             String       @id @default(cuid())
  studentId      String
  academicYearId String
  classId        String
  sectionId      String?
  rollNumber     Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section?     @relation(fields: [sectionId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
}

model Subject {
  id                 String              @id @default(cuid())
  name               String              @unique
  code               String?
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  classSubjects      ClassSubject[]
  examSubjects       ExamSubject[]
  teacherAssignments TeacherAssignment[]
}

model ClassSubject {
  id             String       @id @default(cuid())
  classId        String
  subjectId      String
  academicYearId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId, academicYearId])
  @@index([classId])
  @@index([subjectId])
}

model AcademicTerm {
  id             String       @id @default(cuid())
  academicYearId String
  name           String
  order          Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exams          Exam[]

  @@unique([academicYearId, order])
  @@unique([academicYearId, name])
  @@index([academicYearId])
}

model Exam {
  id           String        @id @default(cuid())
  termId       String
  classId      String
  gradeScaleId String?
  name         String
  startDate    DateTime?
  endDate      DateTime?
  isPublished  Boolean       @default(false)
  isLocked     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  class        Class         @relation(fields: [classId], references: [id])
  term         AcademicTerm  @relation(fields: [termId], references: [id], onDelete: Cascade)
  gradeScale   GradeScale?   @relation(fields: [gradeScaleId], references: [id], onDelete: Restrict)
  subjects     ExamSubject[]

  @@index([termId])
  @@index([classId])
  @@index([gradeScaleId])
}

model ExamSubject {
  id                 String   @id @default(cuid())
  examId             String
  subjectId          String
  theoryFullMarks    Decimal  @db.Decimal(6, 2)
  practicalFullMarks Decimal  @db.Decimal(6, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  exam               Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject            Subject  @relation(fields: [subjectId], references: [id])
  marks              Mark[]

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
}

model Mark {
  id             String      @id @default(cuid())
  examSubjectId  String
  studentId      String
  theoryMarks    Decimal     @db.Decimal(6, 2)
  practicalMarks Decimal     @db.Decimal(6, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  examSubject    ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([studentId])
  @@index([examSubjectId])
}

model GradeScale {
  id                       String            @id @default(cuid())
  name                     String
  description              String?
  isDefault                Boolean           @default(false)
  usesExclusiveUpperBounds Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  entries                  GradeScaleEntry[]
  exams                    Exam[]
}

model GradeScaleEntry {
  id            String     @id @default(cuid())
  gradeScaleId  String
  minPercentage Decimal    @db.Decimal(5, 2)
  maxPercentage Decimal    @db.Decimal(5, 2)
  grade         String
  gradePoint    Decimal    @db.Decimal(4, 2)
  gradeScale    GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Cascade)

  @@index([gradeScaleId])
}

model TeacherAssignment {
  id             String       @id @default(cuid())
  teacherId      String
  classId        String
  subjectId      String
  academicYearId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id])
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, subjectId, academicYearId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([academicYearId])
}

model FeeStructure {
  id             String       @id @default(cuid())
  academicYearId String
  classId        String
  feeType        FeeType
  name           String
  amount         Decimal
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  frequency      FeeFrequency
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, classId, feeType, name])
  @@index([academicYearId])
  @@index([classId])
}

model StudentDiscount {
  id             String               @id @default(cuid())
  studentId      String
  academicYearId String
  name           String
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  notes          String?
  percentage     Decimal
  endDate        DateTime?
  startDate      DateTime
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student        Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTypes       StudentDiscountFee[]

  @@index([studentId])
  @@index([academicYearId])
  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
}

model StudentDiscountFee {
  id         String          @id @default(cuid())
  discountId String
  feeType    FeeType
  discount   StudentDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([discountId, feeType])
  @@index([discountId])
}

model StudentCharge {
  id             String       @id @default(cuid())
  studentId      String
  academicYearId String
  description    String
  quantity       Decimal      @default(1)
  rate           Decimal
  amount         Decimal
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  endDate        DateTime?
  feeType        FeeType      @default(MISCELLANEOUS)
  frequency      FeeFrequency @default(ONE_TIME)
  startDate      DateTime

  billItems    BillItem[]
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYearId])
  @@index([feeType])
  @@index([frequency])
  @@index([startDate])
  @@index([endDate])
}

model Bill {
  id             String     @id @default(cuid())
  studentId      String
  academicYearId String
  billNumber     String     @unique
  billingDate    DateTime   @default(now())
  dueDate        DateTime?
  totalAmount    Decimal
  discountAmount Decimal    @default(0)
  paidAmount     Decimal    @default(0)
  status         BillStatus @default(UNPAID)
  notes          String?

  periodStartYear  Int
  periodStartMonth Int
  periodEndYear    Int
  periodEndMonth   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYear              AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student                   Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  creditApplications        BillCreditApplication[]
  items                     BillItem[]
  payments                  Payment[]
  studentChargeApplications StudentChargeApplication[]

  @@index([studentId])
  @@index([academicYearId])
  @@index([billingDate])
  @@index([periodStartYear, periodStartMonth])
  @@index([periodEndYear, periodEndMonth])
  @@index([status])
}

model BillItem {
  id                String                    @id @default(cuid())
  billId            String
  feeType           FeeType
  description       String
  quantity          Decimal                   @default(1)
  rate              Decimal
  amount            Decimal
  createdAt         DateTime                  @default(now())
  discountAmount    Decimal                   @default(0)
  discountPercent   Decimal                   @default(0)
  netAmount         Decimal
  studentChargeId   String?
  bill              Bill                      @relation(fields: [billId], references: [id], onDelete: Cascade)
  studentCharge     StudentCharge?            @relation(fields: [studentChargeId], references: [id])
  chargeApplication StudentChargeApplication?

  @@index([billId])
  @@index([studentChargeId])
}

model StudentChargeApplication {
  id              String    @id @default(cuid())
  studentChargeId String
  billId          String
  billItemId      String    @unique
  isActive        Boolean   @default(true)
  releasedAt      DateTime?
  releaseReason   String?
  createdAt       DateTime  @default(now())
  bill            Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  billItem        BillItem  @relation(fields: [billItemId], references: [id], onDelete: Cascade)

  @@index([studentChargeId])
  @@index([billId])
}

model StudentCredit {
  id                       String                  @id @default(cuid())
  studentId                String
  academicYearId           String
  amount                   Decimal
  appliedAmount            Decimal                 @default(0)
  source                   String
  notes                    String?
  sourcePaymentId          String?                 @unique
  issueDate                DateTime?
  reason                   String?
  issuedByUserId           String?
  issuanceIdempotencyKey   String?                 @unique
  issuanceRequestHash      String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  applications             BillCreditApplication[]
  academicYear             AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  issuedBy                 User?                   @relation("StudentCreditIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  sourcePayment            Payment?                @relation(fields: [sourcePaymentId], references: [id])
  student                  Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYearId])
  @@index([issuedByUserId])
}

model BillCreditApplication {
  id                     String        @id @default(cuid())
  billId                 String
  creditId               String
  amount                 Decimal
  appliedByUserId        String?
  idempotencyKey         String?       @unique
  idempotencyRequestHash String?
  reversedAt             DateTime?
  reversedByUserId       String?
  reversalReason         String?
  createdAt              DateTime      @default(now())
  appliedBy              User?         @relation("BillCreditApplicationActor", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  bill                   Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  credit                 StudentCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  reversedBy             User?         @relation("BillCreditApplicationReverser", fields: [reversedByUserId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([creditId])
  @@index([billId, reversedAt])
  @@index([creditId, reversedAt])
  @@index([appliedByUserId])
  @@index([reversedByUserId])
}

model Payment {
  id                     String         @id @default(cuid())
  billId                 String
  amount                 Decimal
  paymentDate            DateTime       @default(now())
  method                 PaymentMethod  @default(CASH)
  reference              String?
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  waiverAmount           Decimal        @default(0)
  waiverReason           String?
  idempotencyKey         String?        @unique
  idempotencyRequestHash String?
  bill                   Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  credit                 StudentCredit?

  @@index([billId])
  @@index([paymentDate])
  @@index([method])
}

model Expense {
  id             String          @id @default(cuid())
  academicYearId String
  category       ExpenseCategory
  description    String
  amount         Decimal
  expenseDate    DateTime        @default(now())
  paidTo         String?
  paymentMethod  PaymentMethod   @default(CASH)
  reference      String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  voidedAt       DateTime?
  voidReason     String?
  voidedByUserId String?
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  voidedBy       User?           @relation("ExpenseVoider", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([academicYearId])
  @@index([category])
  @@index([expenseDate])
  @@index([paymentMethod])
  @@index([voidedAt])
  @@index([voidedByUserId])
}

model TeacherSalary {
  id             String              @id @default(cuid())
  teacherId      String
  academicYearId String

  month          Int
  year           Int
  salaryAmount   Decimal
  deduction      Decimal             @default(0)
  netAmount      Decimal
  status         SalaryPaymentStatus @default(PENDING)

  // Kept for compatibility with existing salary records.
  paymentDate   DateTime?
  paymentMethod PaymentMethod        @default(CASH)
  reference     String?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  academicYear  AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher       Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  payments      TeacherSalaryPayment[]

  @@unique([teacherId, academicYearId, month, year])
  @@index([teacherId])
  @@index([academicYearId])
  @@index([status])
  @@index([paymentDate])
}

model TeacherSalaryPayment {
  id              String @id @default(cuid())
  teacherSalaryId String

  amount      Decimal
  paymentDate DateTime      @default(now())
  method      PaymentMethod @default(CASH)

  reference              String?
  notes                  String?
  recordedByUserId       String?
  idempotencyKey         String? @unique
  idempotencyRequestHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recordedBy    User?         @relation("SalaryPaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  teacherSalary TeacherSalary @relation(fields: [teacherSalaryId], references: [id], onDelete: Cascade)

  @@index([teacherSalaryId])
  @@index([paymentDate])
  @@index([method])
  @@index([recordedByUserId])
}

enum UserRole {
  ADMIN
  ACCOUNTANT
}

enum FeeType {
  TUITION
  ADMISSION
  BUS
  COMPUTER_LAB
  EXAM
  MISCELLANEOUS
}

enum BillStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  ONLINE
  OTHER
}

enum FeeFrequency {
  MONTHLY
  TERM
  ANNUAL
  ONE_TIME
}

enum ExpenseCategory {
  OFFICE_SUPPLIES
  ELECTRICITY
  WATER
  INTERNET
  MAINTENANCE
  TRANSPORT
  MEDICAL
  SALARY
  FOOD
  RENT
  TAX
  OTHER
}

enum SalaryPaymentStatus {
  PENDING
  PAID
  PARTIAL
}
